#!/usr/bin/env bash

[ -z "${DEBUG:-}" ] || set -x

set -euo pipefail

_gh_claude_source_dir=$(dirname "${BASH_SOURCE[0]}")

# Verify required dependencies are installed
#
# Checks that Bash 4.4+, gh, and claude are available.
# Prints installation instructions and exits if any are missing.
_check_dependencies() {
	if [[ "${BASH_VERSINFO[0]}" -lt 4 || ("${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 4) ]]; then
		echo "gh-claude: requires Bash 4.4+ (found ${BASH_VERSION})" >&2
		echo "  macOS: brew install bash" >&2
		exit 1
	fi

	local missing=()

	if ! command -v gh &>/dev/null; then
		missing+=("gh      — https://cli.github.com")
	fi
	if ! command -v claude &>/dev/null; then
		missing+=("claude  — https://docs.anthropic.com/en/docs/claude-code")
	fi
	if ! command -v gum &>/dev/null; then
		missing+=("gum     — https://github.com/charmbracelet/gum")
	fi
	if [[ ${#missing[@]} -gt 0 ]]; then
		echo "gh-claude: missing required dependencies:" >&2
		for dep in "${missing[@]}"; do
			echo "  $dep" >&2
		done
		exit 1
	fi
}

_check_dependencies

# Source command modules
source "$_gh_claude_source_dir/scripts/gh_cmd.sh"
source "$_gh_claude_source_dir/scripts/gh_pr.sh"
source "$_gh_claude_source_dir/scripts/gh_issue.sh"
source "$_gh_claude_source_dir/scripts/gh_run.sh"

# Help function
#
# Displays comprehensive help information for all commands
# including usage examples and available options.
_show_help() {
	cat <<'EOF'
gh claude - AI-powered GitHub CLI extension

USAGE:
    gh claude [CLAUDE_OPTIONS] <command> [subcommand] [options]

COMMANDS:
    pr          Pull request operations (create, edit, review, explain, chat)
    issue       Issue operations (create, edit, plan, chat)
    run         Workflow run operations (explain, chat)

FLAGS:
    -V, --version   Print version

CLAUDE OPTIONS:
    Options placed before the subcommand are forwarded to the claude binary.
    For example: --model, --verbose, --resume, --session-id, --allowedTools,
    --disallowedTools, --effort, --permission-mode, --mcp-config, etc.

EXAMPLES:
    gh claude pr chat 42
    gh claude --model sonnet pr chat 42
    gh claude --verbose --effort high issue chat 7
    gh claude --resume <UUID> pr chat 42

SEE ALSO:
    gh claude pr --help        # PR command help
    gh claude issue --help     # Issue command help
    gh claude run --help       # Run command help
EOF
}

# Version function
#
# Reads and displays the current version from version.txt.
_show_version() {
	cat "$_gh_claude_source_dir/version.txt"
}

# Main entry point
main() {
	# Collect claude agent args before the first subcommand keyword
	_GH_CLAUDE_ARGS=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		pr | issue | run)
			break
			;;
		--version | -V)
			_show_version
			return 0
			;;
		--help | -h | help)
			_show_help
			return 0
			;;
		*)
			_GH_CLAUDE_ARGS+=("$1")
			shift
			;;
		esac
	done

	local cmd="${1:-}"
	shift || true

	case $cmd in
	pr)
		_gh_pr "$@"
		;;
	issue)
		_gh_issue "$@"
		;;
	run)
		_gh_run "$@"
		;;
	"")
		_show_help
		;;
	*)
		gum log --level error "unknown command '$cmd'"
		gum log --level info "Available commands: pr, issue, run"
		gum log --level info "Run 'gh claude --help' for usage information"
		exit 1
		;;
	esac
}

main "$@"
