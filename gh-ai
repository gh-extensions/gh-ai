#!/usr/bin/env bash

[ -z "${DEBUG:-}" ] || set -x

set -euo pipefail

_gh_ai_source_dir=$(dirname "${BASH_SOURCE[0]}")

# Verify required dependencies are installed
#
# Checks that Bash 4.4+, gh, claude, gum, and envsubst are available.
# Prints installation instructions and exits if any are missing.
_check_dependencies() {
	if [[ "${BASH_VERSINFO[0]}" -lt 4 || ("${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 4) ]]; then
		echo "gh-ai: requires Bash 4.4+ (found ${BASH_VERSION})" >&2
		echo "  macOS: brew install bash" >&2
		exit 1
	fi

	local missing=()

	if ! command -v gh &>/dev/null; then
		missing+=("gh      — https://cli.github.com")
	fi
	if ! command -v claude &>/dev/null; then
		missing+=("claude  — https://docs.anthropic.com/en/docs/claude-code")
	fi
	if ! command -v gum &>/dev/null; then
		missing+=("gum     — https://github.com/charmbracelet/gum")
	fi
	if ! command -v envsubst &>/dev/null; then
		missing+=("envsubst — https://www.gnu.org/software/gettext (macOS: brew install gettext)")
	fi
	if [[ ${#missing[@]} -gt 0 ]]; then
		echo "gh-ai: missing required dependencies:" >&2
		for dep in "${missing[@]}"; do
			echo "  $dep" >&2
		done
		exit 1
	fi
}

_check_dependencies

# Source command modules
source "$_gh_ai_source_dir/scripts/gh_cmd.sh"
source "$_gh_ai_source_dir/scripts/gh_commit.sh"
source "$_gh_ai_source_dir/scripts/gh_pr.sh"
source "$_gh_ai_source_dir/scripts/gh_issue.sh"
source "$_gh_ai_source_dir/scripts/gh_run.sh"

# Help function
#
# Displays comprehensive help information for all commands
# including usage examples and available options.
_show_help() {
	cat <<'EOF'
gh ai - AI-powered GitHub CLI extension

USAGE:
    gh ai <command> [subcommand] [options]

COMMANDS:
    pr          Pull request operations (create, edit, review, explain)
    commit      Generate a commit message for staged changes
    issue       Issue operations (create, edit, develop)
    run         Workflow run operations (explain)

SEE ALSO:
    gh ai pr --help        # PR command help
    gh ai commit --help    # Commit command help
    gh ai issue --help     # Issue command help
    gh ai run --help       # Run command help
EOF
}

# Version function
#
# Reads and displays the current version from version.txt.
_show_version() {
	cat "$_gh_ai_source_dir/version.txt"
}

# Main entry point
main() {
	local command="${1:-}"
	shift || true

	case $command in
	pr)
		_gh_pr "$@"
		;;
	commit)
		_gh_commit "$@"
		;;
	issue)
		_gh_issue "$@"
		;;
	run)
		_gh_run "$@"
		;;
	--version | -V)
		_show_version
		;;
	--help | -h | help | "")
		_show_help
		;;
	*)
		gum log --level error "Unknown command '$command'"
		gum log --level info "Available commands: pr, commit, issue, run"
		gum log --level info "Run 'gh ai --help' for usage information"
		exit 1
		;;
	esac
}

main "$@"
