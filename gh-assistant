#!/usr/bin/env bash

[ -z "${DEBUG:-}" ] || set -x

set -euo pipefail

_gh_assistant_source_dir=$(dirname "${BASH_SOURCE[0]}")

# Verify required dependencies are installed
#
# Checks that gh, claude, and gum are available on PATH.
# Prints installation instructions and exits if any are missing.
_check_dependencies() {
	local missing=()

	if ! command -v gh &>/dev/null; then
		missing+=("gh      — https://cli.github.com")
	fi
	if ! command -v claude &>/dev/null; then
		missing+=("claude  — https://docs.anthropic.com/en/docs/claude-code")
	fi
	if ! command -v gum &>/dev/null; then
		missing+=("gum     — https://github.com/charmbracelet/gum")
	fi

	if [[ ${#missing[@]} -gt 0 ]]; then
		echo "gh-assistant: missing required dependencies:" >&2
		for dep in "${missing[@]}"; do
			echo "  $dep" >&2
		done
		exit 1
	fi
}

_check_dependencies

# Source command modules
source "$_gh_assistant_source_dir/scripts/gh_cmd.sh"
source "$_gh_assistant_source_dir/scripts/gh_commit.sh"
source "$_gh_assistant_source_dir/scripts/gh_pr.sh"

# Help function
#
# Displays comprehensive help information for all commands
# including usage examples and available options.
_show_help() {
	cat <<'EOF'
gh assistant - AI-powered GitHub CLI extension

USAGE:
    gh assistant <command> [subcommand] [options]

COMMANDS:
    pr          Pull request operations (create, review)
    commit      Generate a commit message for staged changes

SEE ALSO:
    gh assistant pr --help        # PR command help
    gh assistant commit --help    # Commit command help
EOF
}

# Main entry point
main() {
	local command="${1:-}"
	shift || true

	case $command in
	pr)
		_gh_pr "$@"
		;;
	commit)
		_gh_commit "$@"
		;;
	--help | -h | help | "")
		_show_help
		;;
	*)
		gum log --level error "Unknown command '$command'"
		gum log --level info "Available commands: pr, commit"
		gum log --level info "Run 'gh assistant --help' for usage information"
		exit 1
		;;
	esac
}

main "$@"
