#!/bin/bash

[ -z "$DEBUG" ] || set -x

_gh_assistant_source_dir=$(dirname "${BASH_SOURCE[0]}")

# Source command modules
source "$_gh_assistant_source_dir/scripts/utils.sh"
source "$_gh_assistant_source_dir/scripts/gh_pr.sh"
source "$_gh_assistant_source_dir/scripts/gh_api.sh"
source "$_gh_assistant_source_dir/scripts/gh_commit.sh"

# Help function
#
# Displays comprehensive help information for all commands
# including usage examples and available options.
_show_help() {
	cat <<'EOF'
gh assistant - AI-powered GitHub CLI extension

USAGE:
    gh assistant <command> [subcommand] [options]

COMMANDS:
    commit      Generate a commit message for staged changes
    pr          Pull request operations (create, review)
    api         Low-level GitHub API operations (pr, issue)

SEE ALSO:
    gh assistant commit --help    # Commit command help
    gh assistant pr --help        # PR command help
    gh assistant api --help       # API command help
EOF
}

# Main entry point
main() {
	local command="$1"
	shift

	case $command in
	commit)
		_gh_commit "$@"
		;;
	pr)
		_gh_pr "$@"
		;;
	api)
		_gh_api "$@"
		;;
	--help | -h | help | "")
		_show_help
		;;
	*)
		gum log --level error "Unknown command '$command'"
		gum log --level info "Available commands: commit, pr, api"
		gum log --level info "Run 'gh assistant --help' for usage information"
		exit 1
		;;
	esac
}

main "$@"
